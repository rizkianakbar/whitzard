# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://whitzard:whitzard@127.0.0.1:5433/whitzard?sslmode=disable

# Sepolia (chain id 11155111) or a local Hardhat node (http://127.0.0.1:8545)
RPC_URL=
TOKEN_ADDRESS=
REGISTRY_ADDRESS=
ESCROW_ADDRESS=

# Indexer: START_BLOCK must be at or before the Registry deployment block.
START_BLOCK=
CONFIRMATIONS=2
BATCH_SIZE=500
POLL_INTERVAL=4s

# API
HTTP_ADDR=127.0.0.1:8080
CHAIN_ID=11155111
# Sign-In with Ethereum: must match where the frontend runs
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
EVIDENCE_DIR=./data/evidence
MAX_UPLOAD_BYTES=10485760
PHOTO_DIR=./data/photos
MAX_PHOTO_BYTES=2097152
SESSION_TTL=168h

# Keeper: a separate wallet that only pays gas for finalize(). Fund it with a little Sepolia ETH.
KEEPER_PRIVATE_KEY=
KEEPER_POLL_INTERVAL=15s
